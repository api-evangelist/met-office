{
  "openapi": "3.0.3",
  "info": {
    "title": "Met Office Land Observations Public API",
    "description": "The Observation Location service provides Observation data for specific land locations. \n\n API Usage is typically done in 2 Steps\n\n 1. Call GET /observation-land/1/nearest with either a lat/lon or geohash.\nThis will return the nearest land location with observations.\n\n 2. Call GET /observation-land/1/{geohash} to retrieve the observations for the given land location.\n\n N.B. Calls to the \"nearest\" endpoint should be cached to reduce unnecessary lookups.",
    "contact": {
      "name": "Met Office",
      "url": "https://www.metoffice.gov.uk/about-us/contact",
      "email": "dpt@metoffice.gov.uk"
    },
    "version": "v1.0"
  },
  "security": [
    {
      "APIKey": []
    }
  ],
  "paths": {
    "/nearest": {
      "get": {
        "summary": "Get nearest observation location",
        "description": "Given a Geohash or a lat/lon pair, returns land observation location(s).",
        "parameters": [
          {
            "name": "max",
            "in": "query",
            "description": "Maximum results to return. Defaults to 1 if omitted. Minimum 1, Maximum 5.",
            "required": false,
            "schema": {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "name": "geohash",
            "in": "query",
            "description": "“The Geohash to use as query term. Must be alpha-numeric. All geohashes are valid. Must be a maximum of 6 characters long.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "description": "The latitude value to use as query term. Must be at most 2 decimal places. Must be used alongside `lon`. Must be between -90 and 90.",
            "required": false,
            "schema": {
              "maximum": 90,
              "minimum": -90,
              "type": "number",
              "example": 50.72
            }
          },
          {
            "name": "lon",
            "in": "query",
            "description": "The longitude value to use as query term. Must be at most 2 decimal places. Must be used alongside `lat`. Must be between -180 and 180.",
            "required": false,
            "schema": {
              "maximum": 180,
              "minimum": -180,
              "type": "number",
              "example": -3.53
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Nearest Observation search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "description": "",
                    "properties": {
                      "geohash": {
                        "type": "string",
                        "description": "Geohash of the observation location",
                        "nullable": false,
                        "example": "gcj8ds"
                      },
                      "area": {
                        "type": "string",
                        "description": "Location area",
                        "nullable": false,
                        "example": "Devon"
                      },
                      "region": {
                        "type": "string",
                        "description": "Region code for UK locations",
                        "nullable": true,
                        "example": "sw"
                      },
                      "country": {
                        "type": "string",
                        "description": "The country of the location",
                        "nullable": true,
                        "example": "England"
                      },
                      "olson_time_zone": {
                        "type": "string",
                        "description": "Olson time zone string of location",
                        "nullable": false,
                        "example": "Europe/London"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{geohash}": {
      "get": {
        "summary": "Get weather observations by geohash",
        "description": "Returns a list of weather observations for a specified geohash.",
        "parameters": [
          {
            "name": "geohash",
            "in": "path",
            "description": "“A geohash representing a location supported by the API.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "gcj8ds"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A JSON object representing location Observation data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "description": "Array containing location observation data for requested geohash.",
                    "properties": {
                      "datetime": {
                        "type": "string",
                        "description": "Date of the observation.",
                        "example": "2022-12-14T11:00:00Z",
                        "nullable": false
                      },
                      "humidity": {
                        "type": "integer",
                        "description": "Probability as a percentage of 100.",
                        "example": 70,
                        "nullable": true
                      },
                      "mslp": {
                        "type": "integer",
                        "description": "Mean surface level pressure in hPA.",
                        "example": 991,
                        "nullable": true
                      },
                      "pressure_tendency": {
                        "type": "string",
                        "description": "Pressure tendency representing Rising, Falling or Steady.",
                        "example": "R",
                        "nullable": true
                      },
                      "temperature": {
                        "type": "number",
                        "format": "float",
                        "description": "Air temperature in °C.",
                        "example": 10,
                        "nullable": true
                      },
                      "visibility": {
                        "type": "integer",
                        "description": "Visibility in metres.",
                        "example": 2000,
                        "nullable": true
                      },
                      "weather_code": {
                        "type": "integer",
                        "description": "Numerical code for the weather symbol.",
                        "example": 12,
                        "nullable": true
                      },
                      "wind_direction": {
                        "type": "string",
                        "description": "Direction the wind is travelling from in 16 point compass notation.",
                        "example": "SWW",
                        "nullable": true
                      },
                      "wind_gust": {
                        "type": "number",
                        "format": "float",
                        "description": "Wind gust speed in m/s.",
                        "example": 2,
                        "nullable": true
                      },
                      "wind_speed": {
                        "type": "number",
                        "format": "float",
                        "description": "Wind speed in m/s.",
                        "example": 13.05,
                        "nullable": true
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Location not found or no data available"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "APIKey": {
        "type": "apiKey",
        "description": "The API Key generated with your Subscription in Weather DataHub, this must be set as 'apikey' in your header.",
        "name": "apikey",
        "in": "header"
      }
    }
  }
}
